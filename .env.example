# ==============================================================================
# LIKHA ATELIER — VERCEL & POSTGRESQL ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or paste into Vercel Project Settings > Environment Variables

# PostgreSQL Connection String (Vercel Postgres, Neon, Supabase, Railway, or AWS RDS)
DATABASE_URL="postgres://postgres:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/likha_atelier?sslmode=require"

# Cryptographic JSON Web Token (JWT) Secret (Minimum 32 random characters)
JWT_SECRET="likha-atelier-prestige-jwt-secret-key-2026-secure-archipelago"

# Node Environment
NODE_ENV="production"

