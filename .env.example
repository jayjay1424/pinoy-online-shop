# Likha Atelier — Environment Variables Configuration for Vercel
# Connect your PostgreSQL database on Vercel (Storage tab -> Create Database -> Postgres)
# Vercel will automatically populate POSTGRES_URL and DATABASE_URL.

# 1. PostgreSQL Database Connection String
# Automatically set if using Vercel Postgres / Neon / Supabase:
# POSTGRES_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# DATABASE_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# 2. Patron Authentication JWT Secret (Generate a strong random string)
JWT_SECRET="likha-atelier-prestige-jwt-secret-key-2026-secure-archipelago"

# 3. Environment
NODE_ENV="production"
